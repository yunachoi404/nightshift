{
  "name": "@nightshift/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p ../contract && tsc -p . --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "samples": "tsx scripts/render-samples.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/playfair-display": "^5.2.0",
    "@fontsource-variable/syne": "5.3.0",
    "@fontsource/bebas-neue": "^5.2.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@hyperframes/core": "0.8.174",
    "@hyperframes/producer": "0.8.174",
    "@nightshift/contract": "workspace:*",
    "@puppeteer/browsers": "^3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "Apache-2.0"
}
