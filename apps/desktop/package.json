{
  "name": "@nightshift/desktop",
  "productName": "Nightshift",
  "version": "0.1.0",
  "description": "Nightshift local creator studio",
  "author": "Nightshift contributors",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "pack": "pnpm build && electron-builder --dir --mac --arm64 --publish never",
    "dmg": "pnpm build && electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "electron": "^42.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "org.nightshift.studio",
    "productName": "Nightshift",
    "artifactName": "Nightshift-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/*.cjs",
      "dist/*.cjs.map",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Nightshift contributors"
      }
    },
    "dmg": {
      "title": "Install Nightshift",
      "window": {
        "width": 540,
        "height": 360
      },
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file"
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "dist/runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/.bin/**"
        ]
      }
    ]
  }
}
